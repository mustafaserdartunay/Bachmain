{
  "git.autofetch": false,
  "git.autorefresh": false,
  "git.autoRepositoryScan": false,
  "git.detectSubmodules": false,
  "git.openRepositoryInParentFolders": "never",
  "search.followSymlinks": false,
  "search.maxResults": 2000,
  "npm.autoDetect": "off",
  "workbench.editor.limit.enabled": true,
  "workbench.editor.limit.value": 4,
  "workbench.localHistory.enabled": false,
  "typescript.tsserver.maxTsServerMemory": 384,
  "typescript.tsserver.experimental.enableProjectDiagnostics": false,
  "typescript.disableAutomaticTypeAcquisition": true,
  "javascript.updateImportsOnFileMove.enabled": "never",
  "editor.largeFileOptimizations": true,
  "files.exclude": {
    "**/node_modules": true,
    "**/.next": true,
    "**/dist": true,
    "**/dist-static": true,
    "**/coverage": true,
    "**/.turbo": true,
    "**/restore-backups": true,
    "apps/landing/out": true,
    "**/.vite": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/apps/**/node_modules/**": true,
    "apps/landing/node_modules/**": true,
    "apps/admin/node_modules/**": true,
    "**/dist/**": true,
    "**/dist-static/**": true,
    "**/.next/**": true,
    "apps/landing/out/**": true,
    "**/coverage/**": true,
    "**/.turbo/**": true,
    "**/.vite/**": true,
    "**/node_modules/.vite/**": true,
    "**/build/**": true,
    "**/.cache/**": true,
    "**/.gradle/**": true,
    "**/restore-backups/**": true,
    "**/docs/**": true,
    "**/BACHMAIN_DOCUMENT_CENTER/**": true,
    "apps/landing/public/bachy/**": true,
    "**/*.pack.gz": true,
    "**/.vercel/**": true,
    "**/*.mp4": true,
    "**/*.mov": true,
    "**/*.webm": true,
    "**/*.glb": true,
    "**/*.gltf": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/dist-static": true,
    "**/.next": true,
    "apps/landing/out": true,
    "**/restore-backups": true,
    "**/.vite": true,
    "**/.cache": true,
    "**/coverage": true,
    "**/package-lock.json": true,
    "**/docs": true
  }
}
