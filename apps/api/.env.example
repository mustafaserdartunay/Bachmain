JWT_REFRESH_TTL_SECONDS=1209600

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5180,https://bachmain.com,https://www.bachmain.com,https://uygulama.bachmain.com,https://yonetim.bachmain.com

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
