# OpenAI API key (required for voice assistant + AI Growth Center)
OPENAI_API_KEY=sk-your-key-here

# Optional model (default: gpt-4o for growth / gpt-4o-mini fallback)
OPENAI_MODEL=gpt-4o

# Whisper model for voice transcription (default: whisper-1)
OPENAI_WHISPER_MODEL=whisper-1

# Production server port (default: 4173)
PORT=4173
