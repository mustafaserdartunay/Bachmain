# OpenAI API key (required for voice assistant + AI Growth Center)
OPENAI_API_KEY=sk-your-key-here

# Optional shared secret for AI proxies (recommended in production)
# Clients send: X-Ai-Proxy-Secret: <value>  or Authorization: Bearer <value>
AI_PROXY_SECRET=

# Optional model (default: gpt-5.5-pro — en yüksek kalite)
OPENAI_MODEL=gpt-5.5-pro

# Mesaj merkezi / TeamHub WhatsApp AI (hız odaklı — önerilen)
OPENAI_OMNI_MODEL=gpt-4o-mini
OPENAI_OMNI_REASONING_EFFORT=low
OPENAI_OMNI_MAX_TOKENS=512

# Bach AI V2 product tiers (server/ai/config.js) — optional overrides
# Luna: CRM / intent / basit komut (falls back to OPENAI_MODEL, then gpt-5.5)
OPENAI_MODEL_LUNA=
# Terra: finans / yönetici raporu (default: gpt-5.5-pro)
OPENAI_MODEL_TERRA=
# Sol: çok karmaşık analiz (default: gpt-5.5-pro)
OPENAI_MODEL_SOL=
# Realtime voice models (Phase 4+)
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_MODEL_COMPLEX=gpt-realtime-2.1

# Voice / wake-word timing (ms) — docs only until Phases 4–5 wire them
# AI_VOICE_SHORT_SILENCE_MS=400
# AI_VOICE_LONG_SILENCE_MS=900
# AI_VOICE_FINAL_SILENCE_MS=1500
# AI_VOICE_INTERRUPT_THRESHOLD=0.55
# AI_VOICE_MIN_SPEECH_MS=250
# AI_WAKE_COMMAND_SILENCE_MS=3000
# AI_WAKE_SENSITIVITY=0.65
# AI_WAKE_COOLDOWN_MS=1200

# Reasoning effort for GPT-5.x (none | low | medium | high | xhigh)
OPENAI_REASONING_EFFORT=high

# Transcription model (default: gpt-4o-transcribe)
OPENAI_WHISPER_MODEL=gpt-4o-transcribe

# Stripe (admin billing) — webhook secret required in production when secret key is set
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Production server port (default: 4173)
PORT=4173

# Social Media Center / Meta Instagram Graph (SC-0)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://bachmain.vercel.app/api/social/oauth/callback
# Alternatif (apps/api): https://api.bachmain.com/v1/social/instagram/oauth/callback
META_GRAPH_VERSION=v21.0
VITE_API_URL=https://api.bachmain.com

# Dropelya / Studio yönetim (yerelde http://localhost:3000)
# VITE_DROPELYA_ADMIN_URL=http://localhost:3000

# E-Dönüşüm / Nilvera — never commit real API keys.
# Per-company keys are stored encrypted. Platform env is only for encryption/cron.
# EDOCUMENTS_ENCRYPTION_KEY=
# EDOCUMENTS_CRON_SECRET=
# NILVERA_WEBHOOK_SECRET=

# Google Maps JavaScript API (browser — HTTP referrer restriction)
# Used by Müşteri Finder + Tır Kontrol Merkezi (Routes / Maps / Advanced Marker)
# VITE_GOOGLE_MAPS_API_KEY=
# VITE_GOOGLE_PLACES_API_KEY=
# Optional Map ID for Advanced Markers
# VITE_GOOGLE_MAPS_MAP_ID=
