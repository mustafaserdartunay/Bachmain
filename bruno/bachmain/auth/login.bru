meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{apiBase}}/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

script:post-response {
  if (res.body && res.body.tokens && res.body.tokens.accessToken) {
    bru.setEnvVar("accessToken", res.body.tokens.accessToken);
  }
}

assert {
  res.status: in [200, 401, 403]
}
