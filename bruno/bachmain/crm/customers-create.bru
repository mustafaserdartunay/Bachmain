meta {
  name: Customer create — CRUD write
  type: http
  seq: 2
}

post {
  url: {{apiBase}}/v1/customers
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Bruno Test Musteri",
    "email": "bruno-test@example.com"
  }
}

assert {
  res.status: in [200, 201, 401, 403]
}
