{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/giris",
      "destination": "https://bachmain.com/giris",
      "permanent": false
    },
    {
      "source": "/login",
      "destination": "https://bachmain.com/giris",
      "permanent": false
    },
    {
      "source": "/girisyap",
      "destination": "https://bachmain.com/giris",
      "permanent": false
    },
    {
      "source": "/studio",
      "destination": "https://bachmain-studio.vercel.app/",
      "permanent": false
    },
    {
      "source": "/studio/:path*",
      "destination": "https://bachmain-studio.vercel.app/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/website-os/assets/:path*", "destination": "/website-os/assets/:path*" },
    { "source": "/website-os/:path*", "destination": "/website-os/index.html" },
    { "source": "/((?!api/|website-os/|Templates/|templates/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/app-version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https: wss:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(self), geolocation=(self)" }
      ]
    },
    {
      "source": "/website-os/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
