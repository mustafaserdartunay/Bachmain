{
  "name": "bachmain-crm",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "yonetim:dev": "npm --prefix apps/admin run dev:all",
    "yonetim:open": "bash workspace/scripts/open-system.sh yonetim",
    "uygulama:open": "bash workspace/scripts/open-system.sh uygulama",
    "web:open": "bash workspace/scripts/open-system.sh web",
    "dropelya:dev": "npm --prefix apps/dropelya run dev",
    "dropelya:open": "bash workspace/scripts/open-dropelya.sh",
    "ios:open": "bash workspace/scripts/open-system.sh ios",
    "android:open": "bash workspace/scripts/open-system.sh android",
    "bachmain:open-all": "bash workspace/scripts/open-system.sh",
    "cursor:clean": "bash workspace/scripts/cursor-clean.sh",
    "cursor:apply-settings": "bash workspace/scripts/cursor-apply-settings.sh",
    "cursor:workspaces": "bash workspace/scripts/install-documents-workspaces.sh",
    "build:website-os": "npm --prefix apps/website-os install && npm --prefix apps/website-os run build && rm -rf public/website-os && cp -R apps/website-os/dist public/website-os",
    "build": "vite build",
    "preview": "vite preview --host",
    "start": "node server/index.js",
    "deploy": "npx vercel --prod",
    "dp": "bash scripts/deploy-all.sh",
    "lint": "eslint src server api scripts apps/admin/src apps/admin/server apps/api/src --max-warnings 9999",
    "lint:fix": "eslint src server api scripts apps/admin/src apps/admin/server apps/api/src --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"server/**/*.js\" \"api/**/*.js\" \"apps/admin/src/**/*.{ts,tsx}\" \"apps/api/src/**/*.ts\" \"docs/**/*.md\" \"*.md\" \".github/**/*.{yml,yaml,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"server/**/*.js\" \"api/**/*.js\" \"apps/admin/src/**/*.{ts,tsx}\" \"apps/api/src/**/*.ts\" \"docs/5*.md\" \"docs/6*.md\" \".github/**/*.{yml,yaml,md}\"",
    "typecheck:api": "npm --prefix apps/api run typecheck",
    "build:api": "npm --prefix apps/api run build",
    "build:admin": "npm --prefix apps/admin run build",
    "secret-scan": "node scripts/ci-secret-scan.mjs",
    "ci:local": "npm run lint && npm run typecheck:api && npm run build && npm run build:api && npm run secret-scan",
    "api:dev": "npm --prefix apps/api run dev",
    "api:install": "npm --prefix apps/api install",
    "compose:up": "docker compose up -d db redis",
    "compose:down": "docker compose down",
    "prepare": "husky || true",
    "typecheck:ai": "tsc -p tsconfig.ai.json --noEmit",
    "test:e2e": "playwright test",
    "test:api": "bash scripts/run-bruno.sh",
    "test:lighthouse": "node scripts/run-lighthouse.mjs",
    "test:load": "bash scripts/run-k6.sh",
    "test:report": "node scripts/aggregate-quality-report.mjs",
    "test:quality": "bash scripts/run-quality.sh"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@xyflow/react": "^12.11.2",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "framer-motion": "^12.42.2",
    "html2canvas": "^1.4.1",
    "jsbarcode": "^3.12.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.511.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.16.0",
    "recharts": "^2.15.3",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.30.1",
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.30.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "postcss": "^8.5.3",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vercel": "^59.5.0",
    "vite": "^6.3.5"
  }
}
